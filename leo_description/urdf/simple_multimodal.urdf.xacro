<?xml version="1.0"?>
<robot name="simple_multimodal" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:property name="wheel_radius" value="0.1" />
    <xacro:property name="wheel_width" value="0.05" />
    <xacro:property name="body_size" value="0.3" />
    <xacro:property name="body_height" value="0.15" />
    <xacro:property name="rotor_length" value="0.2" />
    <xacro:property name="rotor_thickness" value="0.02" />
    <xacro:property name="connector_radius" value="0.02" />
    <xacro:property name="connector_height" value="0.1" />

    <gazebo>
      <plugin
        filename="libignition-gazebo-diff-drive-system.so"
        name="ignition::gazebo::systems::DiffDrive">
        <left_joint>wheel_FL_joint</left_joint>
        <right_joint>wheel_FR_joint</right_joint>
        <left_joint>wheel_RL_joint</left_joint>
        <right_joint>wheel_RR_joint</right_joint>
        <wheel_separation>${body_size}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>20</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <max_linear_acceleration>2.5</max_linear_acceleration>
        <max_angular_acceleration>3</max_angular_acceleration>
        <min_linear_acceleration>-2.5</min_linear_acceleration>
        <min_angular_acceleration>-3</min_angular_acceleration>
      </plugin>
      <plugin filename="libignition-gazebo-odometry-publisher-system.so" name="ignition::gazebo::systems::OdometryPublisher">
        <update_frequency>10</update_frequency>
        <odom_topic>true_pose</odom_topic>
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <tf_topic>tf</tf_topic>
      </plugin>
    </gazebo>
    <gazebo>
      <plugin name="gz_plugins::FakeFlightController" filename="libfake_flight_controller.so">
        <topic>/drone/cmd_vel</topic>
        <forceConstant>9.80</forceConstant>
      </plugin>
    </gazebo>
    
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${body_size} ${body_size} ${body_height}"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="${body_size} ${body_size} ${body_height}"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.92"/>
            <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
        </inertial>
    </link>
    
    <xacro:macro name="Lwheel" params="wheel_name x y z">
        <link name="${wheel_name}">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.01"/>
                <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
            </inertial>
        </link>
        <joint name="${wheel_name}_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${wheel_name}"/>
            <origin xyz="${x} ${y} ${z}" rpy="1.57 0 0"/>
            <axis xyz="0 0 -1"/>
        </joint>
    </xacro:macro>

        <xacro:macro name="Rwheel" params="wheel_name x y z">
        <link name="${wheel_name}">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.01"/>
                <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
            </inertial>
        </link>
        <joint name="${wheel_name}_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${wheel_name}"/>
            <origin xyz="${x} ${y} ${z}" rpy="-1.57 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>
    </xacro:macro>
    
    <xacro:macro name="rotor" params="rotor_name x y z">
        <link name="${rotor_name}_connector">
            <visual>
                <geometry>
                    <cylinder radius="${connector_radius}" length="${connector_height}"/>
                </geometry>
                <material name="gray">
                    <color rgba="0.5 0.5 0.5 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${connector_radius}" length="${connector_height}"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.0"/>
                <inertia ixx="0.0" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="0.0"/>
            </inertial>
        </link>
        <joint name="${rotor_name}_connector_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${rotor_name}_connector"/>
            <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
        </joint>
        <link name="${rotor_name}">
            <visual>
                <geometry>
                    <box size="${rotor_length} ${rotor_thickness} ${rotor_thickness}"/>
                </geometry>
                <material name="gray">
                    <color rgba="0.5 0.5 0.5 1"/>
                </material>
            </visual>
            <collision>
                <geometry>
                    <box size="${rotor_length} ${rotor_thickness} ${rotor_thickness}"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.01"/>
                <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
            </inertial>
        </link>
        <joint name="${rotor_name}_joint" type="continuous">
            <parent link="${rotor_name}_connector"/>
            <child link="${rotor_name}"/>
            <origin xyz="0 0 ${connector_height/2}" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>
    </xacro:macro>
    
    <xacro:Lwheel wheel_name="wheel_FL" x="${body_size/2}" y="${body_size/2}" z="-0.1"/>
    <xacro:Rwheel wheel_name="wheel_FR" x="${body_size/2}" y="-${body_size/2}" z="-0.1"/>
    <xacro:Lwheel wheel_name="wheel_RL" x="-${body_size/2}" y="${body_size/2}" z="-0.1"/>
    <xacro:Rwheel wheel_name="wheel_RR" x="-${body_size/2}" y="-${body_size/2}" z="-0.1"/>
    
    <xacro:rotor rotor_name="rotor_FL" x="${body_size/2}" y="${body_size/2}" z="${body_height/2}"/>
    <xacro:rotor rotor_name="rotor_FR" x="${body_size/2}" y="-${body_size/2}" z="${body_height/2}"/>
    <xacro:rotor rotor_name="rotor_RL" x="-${body_size/2}" y="${body_size/2}" z="${body_height/2}"/>
    <xacro:rotor rotor_name="rotor_RR" x="-${body_size/2}" y="-${body_size/2}" z="${body_height/2}"/>
</robot>
